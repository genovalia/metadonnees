{
  // JSON-LD Context: Defines the namespaces for the properties used in this document.
  "@context": {
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "prov": "http://www.w3.org/ns/prov#",
    "vcard": "http://www.w3.org/2006/vcard/ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "time": "http://www.w3.org/2006/time#"
  },
  // The URI of this dataset: its page on Sedna, https://sedna.apps.genovalia.ulaval.ca/datasets/<id>.
  // Filled automatically by create-dataset.
  "@id": "",
  // The type of the resource (DCAT Dataset).
  "@type": "dcat:Dataset",
  // The dataset id as a plain string, matching the directory name (e.g., "apimel1").
  // Filled automatically by create-dataset.
  "dcterms:identifier": "",
  // The date of formal issuance (publication) of the dataset, as YYYY-MM-DD.
  "dcterms:issued": "",
  // The primary language of the dataset (e.g., "en", "fr").
  "dcterms:language": "en",
  // The title of the dataset.
  "dcterms:title": "",
  // A detailed description of the dataset contents and purpose.
  "dcterms:description": "",
  // A Web page that can be navigated to in a Web browser to gain access to the dataset.
  // Same as "@id" (the dataset's page on Sedna). Filled automatically by create-dataset.
  "dcat:landingPage": "",
  // The entity responsible for making the dataset available.
  "dcterms:publisher": {
    "@id": "https://genovalia.ulaval.ca/",
    "@type": "foaf:Organization",
    "foaf:name": "Genovalia",
    "foaf:homepage": "https://genovalia.ulaval.ca/"
  },
  // Contact information that can be used for sending comments about the dataset.
  "dcat:contactPoint": {
    "@type": "vcard:Kind",
    "vcard:fn": "Genovalia",
    "vcard:hasEmail": {
      "@id": "mailto:genovalia@ulaval.ca"
    }
  },
  // A list of keywords (tags) describing the dataset.
  // Reuse the spelling of keywords already used by other datasets.
  "dcat:keyword": [],
  // The main theme/category of the dataset (e.g., a taxonomy URI).
  "dcat:theme": "",
  // Links to the actual data files or API endpoints.
  "dcat:distribution": [],
  // The temporal period covered by the dataset.
  // For an ongoing dataset, omit "time:hasEnd" entirely (never use "present").
  "dcterms:temporal": {
    "@type": "dcterms:PeriodOfTime",
    "time:hasBeginning": {
      "@type": "time:Instant",
      // Year in YYYY format.
      "time:inXSDgYear": ""
    },
    "time:hasEnd": {
      "@type": "time:Instant",
      // Year in YYYY format.
      "time:inXSDgYear": ""
    }
  },
  // The geographic area covered by the dataset, as a canonical GeoNames URI:
  // https://sws.geonames.org/<geonameId>/ (e.g., https://sws.geonames.org/6115047/ for Québec).
  "dcterms:spatial": "",
  // The version of the dataset (MAJOR.MINOR.PATCH). Bump it when the data changes.
  "dcat:version": "1.0.0",
  // The license under which the dataset is made available.
  "dcterms:license": "",
  // Information about who can access the resource or an indication of its security status.
  "dcterms:accessRights": "http://purl.org/eprint/accessRights/RestrictedAccess",
  // The person or organization that created the dataset.
  "dcterms:creator": {
    // URI of the creator (e.g., ORCID or profile link)
    "@id": "",
    "@type": "foaf:Person",
    "foaf:name": "",
    // mailto: email address
    "foaf:mbox": ""
  }
}
